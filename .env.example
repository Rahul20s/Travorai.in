# ── Database (Supabase PostgreSQL) ─────────────────────────────
# Use the Transaction pooler URL (port 6543) for runtime
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) for migrations / prisma studio
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.supabase.com:5432/postgres"

# ── Auth (Clerk) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ── AI Trip Planner ────────────────────────────────────────────
# Standard OpenAI (used by the AI orchestrator)
OPENAI_API_KEY="sk-proj-..."

# Azure OpenAI (optional - used by the legacy chat route)
AZURE_OPENAI_ENDPOINT="https://..."
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_ID=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# ── Add later when needed ──────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RESEND_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
SENTRY_DSN=""

